  <diagram id="uc-13-meditations" name="UC-13 Meditations"><mxGraphModel dx="2098" dy="2798" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0" adaptiveColors="auto">
