          <mxGeometry height="90" width="50" x="2050" y="990" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="swimlane;startSize=32;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#fafafa;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;" value="Manifestia" vertex="1">
          <mxGeometry height="1480" width="1740" x="250" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="ucOpen" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" value="Open Meditation Practice&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[User opens the app outside the scheduled anchors and chooses to meditate]&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="250" x="36" y="320" as="geometry" />
        </mxCell>
        <mxCell id="noteOpen" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Open practice&lt;/b&gt;&lt;br&gt;Open practice is the only place where the user browses by current feeling.&lt;br&gt;The user is presented with three meditation tracks based on how they feel.&lt;br&gt;Examples: Anxious, Flat, Angry, Scattered, Sad, Grateful, Strong.&lt;br&gt;Scheduled night selection is system-driven from state + programme phase; browsing by feeling happens only in open practice.&lt;br&gt;&lt;i&gt;Feelings are not separate use cases.&lt;/i&gt;" vertex="1">
          <mxGeometry height="175" width="270" x="36" y="130" as="geometry" />
        </mxCell>
        <mxCell id="notePhase" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Dream Embodiment — backbone evolution&lt;/b&gt;&lt;br&gt;Dream Embodiment becomes the backbone practice later in the journey.&lt;br&gt;Chapter 4 — Days 31–40: imagery holds lengthen, and Weekly Immersion moves to full length.&lt;br&gt;&lt;i&gt;Programme-phase rule — not a separate use case.&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="350" y="290" as="geometry" />
        </mxCell>
        <mxCell id="ucPractice" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#23445d;strokeWidth=2;fontStyle=1;fontSize=14;align=center;" value="Practice Meditation" vertex="1">
          <mxGeometry height="140" width="360" x="350" y="461" as="geometry" />
        </mxCell>
        <mxCell id="ucGuided" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Choose Guided or Music-Only&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[User selects presentation mode]&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="250" x="46" y="731" as="geometry" />
        </mxCell>
        <mxCell id="noteGuided" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Guided / music-only&lt;/b&gt;&lt;br&gt;Every meditation type exists in a Guided version and a Music-only version. Both have the same length and emotional arc." vertex="1">
          <mxGeometry height="110" width="270" x="36" y="880" as="geometry" />
        </mxCell>
        <mxCell id="noteTypes" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Seven meditation types&lt;/b&gt; &lt;i&gt;(not separate use cases)&lt;/i&gt;&lt;br&gt;1. &lt;b&gt;Dream Embodiment&lt;/b&gt; — 10–15 min, Night, backbone; settled and clarity adequate&lt;br&gt;2. &lt;b&gt;Limiting Belief Release&lt;/b&gt; — 12–15 min, Night, 2–3× weekly in belief phases; adequate capacity; never after distress&lt;br&gt;3. &lt;b&gt;Belief Installation&lt;/b&gt; — 8–12 min, Morning / before difficult situations; confidence drop, action avoided, or before a declared event&lt;br&gt;4. &lt;b&gt;Gratitude Amplification&lt;/b&gt; — 8–12 min, morning / midday / night touchpoints; low affect or comparison&lt;br&gt;5. &lt;b&gt;The Still Point&lt;/b&gt; — 6–15 min, Early by archetype; fixed weekly; over-driving or outcome attachment&lt;br&gt;6. &lt;b&gt;Event Rehearsal&lt;/b&gt; — 10–18 min, On demand, 2× monthly; seven-day pre-event protocol&lt;br&gt;7. &lt;b&gt;The Weekly Immersion&lt;/b&gt; — 25–30 min, Once weekly at start of user&#39;s week; complete continuous arc" vertex="1">
          <mxGeometry height="168" width="780" x="920" y="46" as="geometry" />
        </mxCell>
        <mxCell id="ucSelect" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Select Meditation by State" vertex="1">
          <mxGeometry height="78" width="260" x="920" y="230" as="geometry" />
        </mxCell>
        <mxCell id="notePriority" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Selection priority&lt;/b&gt;&lt;br&gt;1. Safety&amp;nbsp;&amp;nbsp; 2. Current state&amp;nbsp;&amp;nbsp; 3. Belief work&amp;nbsp;&amp;nbsp; 4. Variety&lt;br&gt;&lt;b&gt;State examples:&lt;/b&gt; Low affect → Gratitude or Belief Installation; Agitation → Still Point; Settled and clear → Dream Embodiment; Repeated avoidance + capacity → Limiting Belief Release.&lt;br&gt;&lt;b&gt;Safety (highest priority):&lt;/b&gt; A distress signal removes Limiting Belief Release and ambitious imagery. Offer Still Point or Gratitude instead. Safety is a constraint, not a user-facing use case." vertex="1">
          <mxGeometry height="165" width="420" x="920" y="320" as="geometry" />
        </mxCell>
        <mxCell id="noteVariety" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Variety rule&lt;/b&gt;&lt;br&gt;No meditation type may be recommended more than three consecutive nights, even if state and programme phase would otherwise repeat it." vertex="1">
          <mxGeometry height="95" width="340" x="1360" y="321" as="geometry" />
        </mxCell>
        <mxCell id="ucGenerate" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Generate Personalized Meditation" vertex="1">
          <mxGeometry height="78" width="270" x="920" y="510" as="geometry" />
        </mxCell>
        <mxCell id="notePersonalize" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Personalization rule&lt;/b&gt;&lt;br&gt;Do not generate a generic stock track with only the user&#39;s name inserted.&lt;br&gt;Personalize to the user&#39;s actual dream, obstacle, relevant personal context, programme state, and current architecture." vertex="1">
          <mxGeometry height="115" width="420" x="920" y="602" as="geometry" />
        </mxCell>
        <mxCell id="ucVoice" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Choose Voice Mode" vertex="1">
          <mxGeometry height="78" width="250" x="920" y="740" as="geometry" />
        </mxCell>
        <mxCell id="noteVoiceModes" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Voice modes&lt;/b&gt;&lt;br&gt;• User&#39;s cloned voice when available/selected&lt;br&gt;• Default voice when cloned voice is not used&lt;br&gt;• Music-only / unguided mode" vertex="1">
          <mxGeometry height="95" width="420" x="920" y="832" as="geometry" />
        </mxCell>
        <mxCell id="ucRender" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Generate / Render Meditation Audio" vertex="1">
          <mxGeometry height="84" width="280" x="920" y="950" as="geometry" />
        </mxCell>
        <mxCell id="noteAudio" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Audio generation&lt;/b&gt;&lt;br&gt;• Guided and music-only versions; same length and emotional arc&lt;br&gt;• Personalized script mixed with appropriate music at generation time&lt;br&gt;• Stem-based music beds; generated at the required length&lt;br&gt;• Cached for offline use; consistent loudness and fade behavior&lt;br&gt;• User&#39;s cloned voice is the preferred personalized voice element where applicable" vertex="1">
          <mxGeometry height="120" width="520" x="950" y="1050" as="geometry" />
        </mxCell>
