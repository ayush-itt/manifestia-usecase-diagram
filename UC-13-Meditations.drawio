        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid line = association&lt;br&gt;Dashed &amp;lt;&amp;lt;include&amp;gt;&amp;gt; = mandatory&lt;br&gt;Dashed &amp;lt;&amp;lt;extend&amp;gt;&amp;gt; = optional / conditional&lt;br&gt;Blue ovals = includes&lt;br&gt;Amber ovals = extends&lt;br&gt;Yellow notes = rules / constraints&lt;br&gt;Arc jump = crossing connectors" vertex="1">
