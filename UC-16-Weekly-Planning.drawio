        <mxCell id="noteCascade" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Architecture cascade&lt;/b&gt; &lt;i&gt;(context — not actors or use cases)&lt;/i&gt;&lt;br&gt;Three-Year Life → One-Year Proof → 90-Day Move → Weekly Move → Daily Action.&lt;br&gt;The Weekly Move is the current weekly piece of the 90-day outcome. It must remain traceable to the 90-day move, one-year proof, and three-year life.&lt;br&gt;The Daily Action is generated from the Weekly Move. Weekly Planning establishes the weekly unit; it does not implement the daily action." vertex="1">
          <mxGeometry height="130" width="690" x="1010" y="950" as="geometry" />
        </mxCell>
        <mxCell id="ucActAs" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Choose Act-as Challenge" vertex="1">
          <mxGeometry height="78" width="250" x="740" y="1110" as="geometry" />
