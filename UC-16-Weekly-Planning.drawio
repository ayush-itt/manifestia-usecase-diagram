        <mxCell id="ucPlan" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#23445d;strokeWidth=2;fontStyle=1;fontSize=14;align=center;" value="Plan My Week" vertex="1">
          <mxGeometry height="140" width="340" x="360" y="580" as="geometry" />
        </mxCell>
        <mxCell id="ucImmersion" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Complete Weekly Immersion" vertex="1">
          <mxGeometry height="78" width="250" x="740" y="60" as="geometry" />
        </mxCell>
        <mxCell id="noteImmersion" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Weekly Immersion + timing&lt;/b&gt;&lt;br&gt;Weekly Immersion occurs at the start of the week and planning follows it so the weekly move is chosen from an elevated state.&lt;br&gt;Weekly Immersion: 25–30 minutes once weekly at the start of the week.&lt;br&gt;Weekly Planning: 20–25 minutes on the user&#39;s chosen day, immediately following the Weekly Immersion.&lt;br&gt;&lt;b&gt;One continuous arc&lt;/b&gt; &lt;i&gt;(not separate use cases)&lt;/i&gt; — Arrival (extended dissolve) · Gratitude · Release · Installation · Dream · Week Ahead. Week Ahead names the weekly move and commits the first action while the user remains elevated." vertex="1">
          <mxGeometry height="200" width="670" x="1030" y="48" as="geometry" />
        </mxCell>
        <mxCell id="ucEvidence" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Review Weekly Evidence" vertex="1">
