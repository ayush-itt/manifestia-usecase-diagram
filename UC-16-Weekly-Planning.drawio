        <mxCell id="boundary" parent="1" style="swimlane;startSize=32;horizontal=1;collapsible=0;container=1;pointerEvents=0;fillColor=#fafafa;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;" value="Manifestia" vertex="1">
          <mxGeometry height="1460" width="1740" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="noteIfThen" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;If-then planning&lt;/b&gt;&lt;br&gt;If-then planning is an intervention for resistance, not the default planning method.&lt;br&gt;&lt;b&gt;If resistance persists:&lt;/b&gt;&lt;br&gt;1. Shrink the action to a 2-minute version.&lt;br&gt;2. If resistance remains, offer a Future Self conversation.&lt;br&gt;3. If resistance continues, route the resistance into belief excavation.&lt;br&gt;&lt;i&gt;Weekly-planning rule only — not the full belief workflow.&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="312" x="139" y="232" as="geometry" />
        </mxCell>
        <mxCell id="ucIfThen" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" value="Create If-Then Plan&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[User is blocked / resisting the planned action]&lt;/font&gt;" vertex="1">
