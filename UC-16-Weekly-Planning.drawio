        <mxCell id="ucCouncil" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Conduct Future Self Council" vertex="1">
          <mxGeometry height="78" width="250" x="740" y="744" as="geometry" />
        </mxCell>
        <mxCell id="noteCouncil" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Future Self Council&lt;/b&gt;&lt;br&gt;A 5–6 minute structured conversation about the week ahead, performed before planning. Plan from the future perspective rather than only from present constraints. Mandatory before the Weekly Move is finalized." vertex="1">
          <mxGeometry height="90" width="520" x="1010" y="840" as="geometry" />
        </mxCell>
        <mxCell id="ucMove" parent="boundary" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="Choose Weekly Move" vertex="1">
          <mxGeometry height="78" width="250" x="740" y="960" as="geometry" />
