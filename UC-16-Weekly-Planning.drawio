        <mxCell id="noteBelief" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Belief pattern&lt;/b&gt;&lt;br&gt;Check whether the old belief/pattern appeared during the week and whether anything contradicted it. Output contributes to the counter-evidence / belief system." vertex="1">
          <mxGeometry height="82" width="420" x="1030" y="367" as="geometry" />
