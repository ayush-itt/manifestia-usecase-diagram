        <mxCell id="noteMemory" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Future memory generation&lt;/b&gt;&lt;br&gt;Future Self memory is generated from the user&#39;s three-layer architecture and then combined with the running record of previous Future Self conversations and journey activity.&lt;br&gt;&lt;i&gt;Generation is setup; each interaction loads/retrieves that memory.&lt;/i&gt;" vertex="1">
          <mxGeometry height="118" width="330" x="860" y="46" as="geometry" />
