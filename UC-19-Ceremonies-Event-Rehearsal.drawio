        <mxCell id="noteLadder" parent="boundary" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;spacingRight=8;spacingTop=6;fontSize=10;verticalAlign=top;" value="&lt;b&gt;Ceremonial ladder:&lt;/b&gt;&lt;br&gt;Day 7  – The First Week Kept&lt;br&gt;Day 14 – The Foundation&lt;br&gt;Day 30 – The Proof&lt;br&gt;Day 45 – The Midpoint&lt;br&gt;Day 60 – The Embodiment&lt;br&gt;Day 75 – The Expansion&lt;br&gt;Day 90 – The Becoming" vertex="1">
